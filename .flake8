[flake8]
max-line-length = 120
extend-ignore =
    E122,
    E202,
    E203,
    E266,
    E301,
    E302,
    E305,
    E303,
    E402,
    E501,
    F401,
    F541,
    W191,
    W291,
    W292,
    W293,
    W391,
    W503
exclude =
    .venv,
    __pycache__,
    alembic,
    migrations,
    uploads,
    scripts,
    ml,
    node_modules
