{
    "uid": "errandbridge-golive",
    "title": "ErrandBridge Go-Live Overview",
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "10s",
    "tags": [
        "errandbridge",
        "golive"
    ],
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "timepicker": {
        "refresh_intervals": [
            "5s",
            "10s",
            "30s",
            "1m",
            "5m",
            "15m",
            "30m",
            "1h",
            "2h",
            "1d"
        ]
    },
    "annotations": {
        "list": []
    },
    "panels": [
        {
            "type": "timeseries",
            "title": "Stripe checkout-session errors (rate)",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "sum(rate(eb_stripe_checkout_session_total{result=\"error\"}[5m]))",
                    "legendFormat": "errors/sec"
                }
            ],
            "id": 1
        },
        {
            "type": "timeseries",
            "title": "Stripe webhook processing errors (rate)",
            "gridPos": {
                "x": 12,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "sum(rate(eb_stripe_webhook_events_total{result=\"error\"}[5m]))",
                    "legendFormat": "errors/sec"
                }
            ],
            "id": 2
        },
        {
            "type": "timeseries",
            "title": "Stripe webhook invalid payloads/signatures (rate)",
            "gridPos": {
                "x": 0,
                "y": 8,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "sum(rate(eb_stripe_webhook_events_total{result=\"invalid\"}[5m]))",
                    "legendFormat": "invalid/sec"
                },
                {
                    "expr": "sum(rate(eb_stripe_webhook_signature_invalid_total[5m]))",
                    "legendFormat": "signature_invalid/sec"
                }
            ],
            "id": 3
        },
        {
            "type": "timeseries",
            "title": "Attachment upload failures (rate)",
            "gridPos": {
                "x": 12,
                "y": 8,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "sum(rate(eb_upload_errand_attachment_total{result=\"error\"}[5m]))",
                    "legendFormat": "failures/sec"
                }
            ],
            "id": 4
        },
        {
            "type": "timeseries",
            "title": "Tracking updates (ok vs rejected)",
            "gridPos": {
                "x": 0,
                "y": 16,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "sum(rate(eb_tracking_update_total{result=\"ok\"}[5m]))",
                    "legendFormat": "ok/sec"
                },
                {
                    "expr": "sum(rate(eb_tracking_update_total{result=\"rejected\"}[5m]))",
                    "legendFormat": "rejected/sec"
                }
            ],
            "id": 5
        },
        {
            "type": "timeseries",
            "title": "Delay detected events (increase)",
            "gridPos": {
                "x": 12,
                "y": 16,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "sum(increase(eb_tracking_delay_detected_total[30m]))",
                    "legendFormat": "delay_detected (30m)"
                }
            ],
            "id": 6
        }
    ]
}