POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=errandbridge
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/errandbridge
PROMETHEUS_MULTIPROC_DIR=/tmp

# Local Grafana login (used by docker-compose + scripts/dev_stack.sh)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Optional ML/decisioning service (heuristics now, ML later)
# When enabled, some admin responses may include `ml_*` enrichment fields.
# In docker-compose, this service is reachable at http://ml:8010
ML_ENABLED=false
ML_SERVICE_URL=http://ml:8010
ML_TIMEOUT_SECONDS=0.8

# CORS (frontend dev server)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# Admin access (comma-separated list of admin emails)
ADMIN_EMAILS=admin@errandbridge.com,oye@errandbridge.com,ajoke@errandbridge.com,ade@errandbridge.com,privacy@errandbridge.com,dataprotection@errandbridge.com,lanre@errandbridge.com
ELEVATED_ADMIN_EMAILS=ade@errandbridge.com

# Optional: password-gated reset for Admin Dashboard visit statistics.
# If unset, the reset endpoint returns 503 (disabled).
# ADMIN_STATS_RESET_PASSWORD=change-me

# Local/dev admin bootstrap (optional)
# If set, the API will create missing admin users for the emails above.
# If reset is enabled, it will also reset existing admin passwords.
# ADMIN_BOOTSTRAP_PASSWORD=Password123!
# ADMIN_BOOTSTRAP_RESET_PASSWORD=false

# OTP hashing pepper (server-side secret)
OTP_PEPPER=dev-otp-pepper-change-me

# OTP verification link base URL (used for link-based OTP delivery)
# Example: https://www.errandbridge.com/verify
OTP_VERIFICATION_LINK_BASE_URL=

# Optional smoke-test OTP overrides (non-production only)
# ALLOW_SMOKE_OTPS=true
# SMOKE_OTP_CODE=123456
# SMOKE_PASSWORD_RESET_OTP=123456
# SMOKE_PASSWORD_CHANGE_OTP=123456

# Optional SMTP settings (if unset, OTP emails are printed to API logs)
# For local testing with the included Mailpit service:
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@errandbridge.local
# SMTP_FROM_NAME=ErrandBridge
# SMTP_USE_TLS=false
# SMTP_AUTH_MODE=login
# SMTP_TIMEOUT_SECONDS=15

# Optional Twilio SMS settings (for OTP delivery via SMS)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_VOICE_NUMBER=

# Public API base URL (used for Twilio Voice webhooks)
# PUBLIC_API_URL=

# Voice WORM (Object Lock) storage
# VOICE_WORM_BUCKET=
# VOICE_WORM_PREFIX=voice
# VOICE_WORM_RETENTION_DAYS=365

# Optional Microsoft Graph settings (Office 365 email delivery)
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SENDER=
# GRAPH_TIMEOUT_SECONDS=15

# Optional Google Sign-In (backend token verification)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_IDS=

# Google OAuth redirect flow (backend-managed sign-in)
# Used by /auth/oauth/google/start + /auth/oauth/google/callback.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8001/auth/oauth/google/callback

# Optional OAuth providers (backend-managed sign-in)
# Used by /auth/oauth/{provider}/start + callbacks.
# Allowed frontend origins that can receive postMessage results from popup callbacks.
# If unset, falls back to CORS_ALLOW_ORIGINS.
# OAUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://errandbridge.com,https://www.errandbridge.com,https://pilot.errandbridge.com

# Apple Sign In (web)
# APPLE_CLIENT_ID=your.service.id
# Optional: if pilots use a separate Apple Services ID for https://pilot.errandbridge.com
# APPLE_PILOT_CLIENT_ID=your.pilot.service.id
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_REDIRECT_URI=https://api.errandbridge.com/auth/oauth/apple/callback
# Optional pilot override (defaults to APPLE_REDIRECT_URI)
# APPLE_PILOT_REDIRECT_URI=https://api.errandbridge.com/auth/oauth/apple/callback

# Optional pilot overrides for Google OAuth redirect flow (backend-managed sign-in)
# GOOGLE_OAUTH_PILOT_CLIENT_ID=
# GOOGLE_OAUTH_PILOT_CLIENT_SECRET=
# GOOGLE_OAUTH_PILOT_REDIRECT_URI=https://api.errandbridge.com/auth/oauth/google/callback

# Optional Stripe settings
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PLUS_PRICE_ID=
# If STRIPE_SUCCESS_URL / STRIPE_CANCEL_URL are unset, the API will derive return URLs
# from the request Origin header (when the origin is allowed).
# Allowed origins are read from (in order):
#   - PAYMENTS_ALLOWED_ORIGINS
#   - OAUTH_ALLOWED_ORIGINS
#   - CORS_ALLOW_ORIGINS
# This prevents localhost test checkouts from bouncing users back to production.
# PAYMENTS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.errandbridge.com
# STRIPE_SUCCESS_URL=https://www.errandbridge.com/payment/success
# STRIPE_CANCEL_URL=https://www.errandbridge.com/payment/cancel

# OpenAI (optional)
# Used by OpenAI-backed chat endpoints and the additive Toxi structured assist.
# OPENAI_API_KEY=

# Toxi structured assist (optional; disabled by default)
OPENAI_TOXI_ENABLED=false
OPENAI_TOXI_MODEL=gpt-4o-mini
OPENAI_TOXI_MAX_TOKENS=450
