# Production dotenv example (DO NOT put real secrets in git)
# In AWS/ECS, prefer injecting these via Secrets Manager / SSM instead of a file.

ENV=prod

# Database (recommended)
# Inject DB_USER/DB_PASSWORD via Secrets Manager, and keep DATABASE_URL using placeholders.
DB_USER=__SET_IN_SECRETS__
DB_PASSWORD=__SET_IN_SECRETS__
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@<rds-endpoint>:5432/errandbridge

# Prometheus multiproc dir (if using gunicorn + multiprocess metrics)
PROMETHEUS_MULTIPROC_DIR=/tmp

# Grafana (if you run Grafana in this environment)
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=__SET_IN_SECRETS__

# CORS
CORS_ALLOW_ORIGINS=https://www.errandbridge.com,https://errandbridge.com,https://api.errandbridge.com

# Auth
JWT_SECRET_KEY=__SET_IN_SECRETS__
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# OTP hashing pepper
OTP_PEPPER=__SET_IN_SECRETS__

# Admin access
ADMIN_EMAILS=admin@errandbridge.com,wole@errandbridge.com,ade@errandbridge.com,privacy@errandbridge.com,dataprotection@errandbridge.com
ELEVATED_ADMIN_EMAILS=ade@errandbridge.com

# Optional: password-gated reset for Admin Dashboard visit statistics.
# If unset, the reset endpoint returns 503 (disabled).
ADMIN_STATS_RESET_PASSWORD=__SET_IN_SECRETS__

# Optional: SMTP / Graph / Twilio / Stripe etc
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@errandbridge.com
# SMTP_USE_TLS=true

# OAuth providers (backend-managed sign-in)
# Allowed frontend origins that can receive postMessage results from popup callbacks.
# OAUTH_ALLOWED_ORIGINS=https://www.errandbridge.com,https://pilot.errandbridge.com

# Apple Sign In (web)
# APPLE_CLIENT_ID=your.service.id
# Optional: if pilots use a separate Apple Services ID for https://pilot.errandbridge.com
# APPLE_PILOT_CLIENT_ID=your.pilot.service.id
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=__SET_IN_SECRETS__
# APPLE_REDIRECT_URI=https://api.errandbridge.com/auth/oauth/apple/callback
# Optional pilot override (defaults to APPLE_REDIRECT_URI)
# APPLE_PILOT_REDIRECT_URI=https://api.errandbridge.com/auth/oauth/apple/callback

# Google OAuth redirect flow
# GOOGLE_OAUTH_CLIENT_ID=__SET_IN_SECRETS__
# GOOGLE_OAUTH_CLIENT_SECRET=__SET_IN_SECRETS__
# GOOGLE_OAUTH_REDIRECT_URI=https://api.errandbridge.com/auth/oauth/google/callback

# Optional pilot overrides for Google OAuth redirect flow
# GOOGLE_OAUTH_PILOT_CLIENT_ID=__SET_IN_SECRETS__
# GOOGLE_OAUTH_PILOT_CLIENT_SECRET=__SET_IN_SECRETS__
# GOOGLE_OAUTH_PILOT_REDIRECT_URI=https://api.errandbridge.com/auth/oauth/google/callback
